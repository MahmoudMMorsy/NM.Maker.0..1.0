{
  "name": "@workspace/nor-maker",
  "version": "1.0.0",
  "description": "NOR Maker AI — Desktop Game Development Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts --port 3000 --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "build:standalone": "vite build --config vite.config.ts && node build-standalone.mjs && npx tsx build-standalone-binaries.ts",
    "serve": "vite preview --config vite.config.ts --port 3000 --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "electron:dev": "concurrently -k \"pnpm dev\" \"wait-on http://localhost:5000 && electron .\"",
    "electron:build": "pnpm build && electron-builder --config electron-builder.config.mjs",
    "electron:build:win": "pnpm build && electron-builder --win   --config electron-builder.config.mjs",
    "electron:build:mac": "pnpm build && electron-builder --mac   --config electron-builder.config.mjs",
    "electron:build:linux": "pnpm build && electron-builder --linux --config electron-builder.config.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "jsdom": "^29.1.1",
    "jszip": "3.10.1",
    "lucide-react": "^0.344.0",
    "motion": "^12.38.0",
    "node-forge": "^1.4.0",
    "omggif": "1.0.10",
    "pako": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vite-plugin-singlefile": "^2.3.2",
    "wait-on": "^8.0.3"
  }
}
